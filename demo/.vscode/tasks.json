{
    "version": "2.0.0",
    "tasks": [
        {
            "label": "Run JavaFX App",
            "type": "shell",
            "command": "mvn",
            "args": ["javafx:run"],
            "group": {
                "kind": "build",
                "isDefault": true
            },
            "options": {
                "env": {
                    "JAVA_HOME": "C:\\Users\\samba\\Downloads\\openjdk-26_windows-x64_bin\\jdk-26"
                }
            },
            "presentation": {
                "reveal": "always",
                "panel": "shared"
            },
            "problemMatcher": "$javac"
        },
        {
            "label": "Compile",
            "type": "shell",
            "command": "mvn",
            "args": ["process-classes"],
            "options": {
                "env": {
                    "JAVA_HOME": "C:\\Users\\samba\\Downloads\\openjdk-26_windows-x64_bin\\jdk-26"
                }
            },
            "presentation": {
                "reveal": "silent",
                "panel": "shared"
            },
            "problemMatcher": "$javac"
        }
    ]
}
